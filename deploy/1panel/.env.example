# 复制为 .env 并填写。放在与 docker-compose.yml 同一编排目录。
# 生成随机密钥：openssl rand -hex 32

# ========== 必填 ==========

# 会话加密密钥（≥32 位随机串）
SESSION_SECRET=

# JWT 签名密钥（另一串随机值，勿与上面相同）
JWT_SECRET=

# 初始管理员账号（仅首次启动时创建，之后改这里无效）
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# ========== 可选 ==========

# 面板/客户端访问用的宿主机端口（默认 8080）
APP_PORT=8080

# 反代账号「密码」的加密密钥。留空则从 SESSION_SECRET 派生。
# ⚠️ 添加账号后请勿再修改 SESSION_SECRET（或本项），否则已存密码无法解密。
# ENCRYPTION_KEY=

# 转发到目标服务器的请求超时（秒），默认 120。大模型长回答可调大。
# REQUEST_TIMEOUT=120
