# Required: Secret key for Starlette SessionMiddleware (min 32 chars)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Required: Secret key for JWT token signing
JWT_SECRET=change-me-to-a-different-random-string

# Default admin credentials (only used on first run to seed initial admin)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# Optional: Database URL (default: SQLite in ./data/proxy.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/proxy.db

# Optional: JWT token expiry in hours (default: 72)
# JWT_EXPIRE_HOURS=72

# Optional: bcrypt rounds (default: 12)
# BCRYPT_ROUNDS=12

# Optional: httpx request timeout in seconds (default: 120)
# REQUEST_TIMEOUT=120.0

# Optional: dedicated key for encrypting stored account passwords.
# If unset, a key is derived from SESSION_SECRET (changing SESSION_SECRET will
# then make existing encrypted passwords undecryptable — set this to decouple them).
# ENCRYPTION_KEY=change-me-to-another-random-string
